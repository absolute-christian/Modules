class SpotifyNow(BasePlugin):
    strings = {
        "ru": {
            "hdr": "Spotify",
            "client_id": "Client ID приложения Spotify",
            "preset": "Вид карточки: banner, center, glow или minimal",
            "redirect": "Redirect URI (нажми, чтобы скопировать)",
            "login": "Войти в Spotify",
            "logout": "Выйти из Spotify",
            "on": "Подключено",
            "off": "Не подключено",
            "no_client": "Сначала вставь Client ID в настройках плагина",
            "no_auth": "Spotify не подключён: Кастомизация → Плагины → Spotify Now",
            "nothing": "Сейчас ничего не играет",
            "browser": "Открыл браузер, подтверди доступ в Spotify",
            "port_busy": "Порт {} занят, закрой программу, которая его использует",
            "connected": "Spotify подключён",
            "auth_fail": "Не удалось войти в Spotify: {}",
            "logged_out": "Вышел из Spotify",
            "rate": "Spotify просит подождать, попробуй позже",
            "api_fail": "Ошибка Spotify: {}",
            "no_pil": "Pillow не загрузился ({}), отправляю текстом",
            "render_fail": "Не удалось нарисовать карточку, отправляю текстом",
            "send_fail": "Не удалось отправить картинку, смотри .logs",
        },
        "en": {
            "hdr": "Spotify",
            "client_id": "Spotify app Client ID",
            "preset": "Card style: banner, center, glow or minimal",
            "redirect": "Redirect URI (tap to copy)",
            "login": "Log in to Spotify",
            "logout": "Log out of Spotify",
            "on": "Connected",
            "off": "Not connected",
            "no_client": "Paste the Client ID in plugin settings first",
            "no_auth": "Spotify is not connected: Customization → Plugins → Spotify Now",
            "nothing": "Nothing is playing right now",
            "browser": "Browser opened, approve access in Spotify",
            "port_busy": "Port {} is busy, close the program using it",
            "connected": "Spotify connected",
            "auth_fail": "Spotify login failed: {}",
            "logged_out": "Logged out of Spotify",
            "rate": "Spotify rate limit, try again later",
            "api_fail": "Spotify error: {}",
            "no_pil": "Pillow failed to load ({}), sending text",
            "render_fail": "Could not render the card, sending text",
            "send_fail": "Could not send the picture, see .logs",
        },
    }

    def __init__(self, *a, **kw):
        super().__init__(*a, **kw)
        self._tok = None
        self._exp = 0
        self._pending = {}

    # ----- утилиты -----

    def _toast(self, text):
        try:
            api.show_toast(text)
        except Exception:
            self.logger.warning(text)

    def _http(self, method, url, headers, body, cb):
        kw = {"headers": headers, "callback": cb}
        if body is not None:
            kw["data"] = body
        getattr(api.http, method)(url, **kw)

    async def _http_async(self, method, url, headers=None, body=None):
        loop = asyncio.get_running_loop()
        fut = loop.create_future()

        def done(res):
            if not fut.done():
                fut.set_result(res)

        def cb(resp, err):
            loop.call_soon_threadsafe(done, (resp, err))

        self._http(method, url, headers or {}, body, cb)
        return await asyncio.wait_for(fut, 30)

    def _client_id(self):
        return (self.get_setting("client_id", "") or "").strip()

    # ----- токены -----

    async def _access_token(self):
        if self._tok and time.time() < self._exp - 30:
            return self._tok
        refresh = api.secrets.get("refresh_token")
        if not refresh:
            return None
        body = {
            "grant_type": "refresh_token",
            "refresh_token": refresh,
            "client_id": self._client_id(),
        }
        resp, err = await self._http_async("post", TOKEN_URL, FORM, body)
        if err or resp is None:
            self.logger.warning("token refresh failed: %s", err)
            return None
        if resp.status != 200:
            self.logger.warning("token refresh status %s: %s", resp.status, resp.text)
            if resp.status in (400, 401) and "invalid_grant" in (resp.text or ""):
                api.secrets.delete("refresh_token")
            return None
        j = resp.json()
        self._tok = j["access_token"]
        self._exp = time.time() + int(j.get("expires_in", 3600))
        if j.get("refresh_token"):
            api.secrets.set("refresh_token", j["refresh_token"])
        return self._tok

    # ----- отправка картинки -----

    def _send_photo(self, peer, path, caption, ents):
        # send_file не принимает entities: запоминаем подпись, а когда сообщение
        # уйдёт (on_message_sent), пробуем поправить её с моноширинным.
        self._pending[caption] = (str(peer), ents)
        if not api.send_file(peer, path, caption, as_photo=True):
            self._pending.pop(caption, None)
            self.logger.warning("send_file отказал, смотри .logs")
            self._toast(self.s("send_fail"))
            return

        def cleanup():
            self._pending.pop(caption, None)
            try:
                os.remove(path)
            except OSError:
                pass

        api.set_timeout(cleanup, 180)

    def on_message_sent(self, info):
        got = self._pending.pop(info.get("text"), None)
        if not got or str(info.get("peer")) != got[0]:
            return
        ok = api.edit_message(info["peer"], info["id"], info["text"], got[1])
        if not ok:
            self.logger.warning("не удалось отформатировать подпись (edit_message)")

    async def _cover_bytes(self, url):
        if not url:
            return None
        try:
            resp, err = await self._http_async("get", url)
        except Exception as e:
            self.logger.warning("cover download failed: %s", e)
            return None
        if err or resp is None or resp.status != 200:
            self.logger.warning("cover download status: %s %s", getattr(resp, "status", None), err)
            return None
        return resp.content

    # ----- команда -----

    @command("now", "Карточка с текущим треком Spotify", aliases=["np"])
    async def now_cmd(self, ctx):
        # Ошибки показываем тостом и ничего не возвращаем, чтобы текст ошибки
        # не попал в поле ввода и случайно не ушёл в чат.
        for attempt in (1, 2):
            token = await self._access_token()
            if not token:
                self._toast(self.s("no_auth"))
                return None
            resp, err = await self._http_async(
                "get", NOW_URL, {"Authorization": "Bearer " + token})
            if err or resp is None:
                self._toast(self.s("api_fail", str(err)))
                return None
            if resp.status == 401 and attempt == 1:
                self._tok = None
                continue
            break

        if resp.status == 204:
            self._toast(self.s("nothing"))
            return None
        if resp.status == 429:
            self._toast(self.s("rate"))
            return None
        if resp.status != 200:
            self.logger.warning("now-playing status %s: %s", resp.status, resp.text)
            self._toast(self.s("api_fail", str(resp.status)))
            return None

        info = track_info(resp.json())
        if info is None:
            self._toast(self.s("nothing"))
            return None

        if Image is None:
            import sys
            err = globals().get("_PIL_ERR", "?")
            self.logger.warning("PIL import failed: %s | sys.path=%s", err, sys.path[:8])
            self._toast(self.s("no_pil", err[:150]))
            return build_text_card(info)

        try:
            raw = await self._cover_bytes(info["cover_url"])
            preset = (self.get_setting("preset", "banner") or "banner").strip().lower()
            loop = asyncio.get_running_loop()
            path = await loop.run_in_executor(None, render_jpeg, info, preset, raw)
        except Exception:
            self.logger.exception("render failed")
            self._toast(self.s("render_fail"))
            return build_text_card(info)

        caption, ents = build_caption(info)
        self._send_photo(ctx.peer, path, caption, ents)
        return ""  # команда исчезает из поля ввода, фото уже ушло

    # ----- авторизация (PKCE + локальный callback) -----

    def _login(self, *_):
        cid = self._client_id()
        if not cid:
            self._toast(self.s("no_client"))
            return

        verifier = _b64url(os.urandom(64))
        challenge = _b64url(hashlib.sha256(verifier.encode()).digest())
        state = _b64url(os.urandom(12))
        result = {}

        class Handler(BaseHTTPRequestHandler):
            def do_GET(h):
                q = urllib.parse.urlparse(h.path)
                if q.path != "/callback":
                    h.send_response(404)
                    h.end_headers()
                    return
                result.update(dict(urllib.parse.parse_qsl(q.query)))
                page = ("<!doctype html><meta charset='utf-8'>"
                        "<body style='font-family:sans-serif;text-align:center;margin-top:20vh'>"
                        "<h2>Подключен</h2><p>Акк Spotify подключен к mokaGram</p>")
                data = page.encode()
                h.send_response(200)
                h.send_header("Content-Type", "text/html; charset=utf-8")
                h.send_header("Content-Length", str(len(data)))
                h.end_headers()
                h.wfile.write(data)

            def log_message(h, *args):
                pass

        try:
            server = HTTPServer(("127.0.0.1", REDIRECT_PORT), Handler)
        except OSError:
            self._toast(self.s("port_busy", REDIRECT_PORT))
            return
        server.timeout = 5

        def wait():
            deadline = time.time() + 180
            try:
                while time.time() < deadline and "code" not in result and "error" not in result:
                    server.handle_request()
            finally:
                server.server_close()

            if "code" not in result:
                self._toast(self.s("auth_fail", result.get("error", "timeout")))
                return
            if result.get("state") != state:
                self._toast(self.s("auth_fail", "state mismatch"))
                return

            body = {
                "grant_type": "authorization_code",
                "code": result["code"],
                "redirect_uri": REDIRECT_URI,
                "client_id": cid,
                "code_verifier": verifier,
            }

            def on_token(resp, err):
                if err or resp is None or resp.status != 200:
                    detail = err or (resp.text if resp is not None else "no response")
                    self.logger.warning("code exchange failed: %s", detail)
                    self._toast(self.s("auth_fail", str(detail)[:120]))
                    return
                j = resp.json()
                api.secrets.set("refresh_token", j["refresh_token"])
                self._tok = j["access_token"]
                self._exp = time.time() + int(j.get("expires_in", 3600))
                self._toast(self.s("connected"))

            self._http("post", TOKEN_URL, FORM, body, on_token)

        threading.Thread(target=wait, daemon=True).start()

        params = urllib.parse.urlencode({
            "client_id": cid,
            "response_type": "code",
            "redirect_uri": REDIRECT_URI,
            "scope": SCOPES,
            "state": state,
            "code_challenge_method": "S256",
            "code_challenge": challenge,
        })
        api.open_url(AUTH_URL + "?" + params)
        self._toast(self.s("browser"))

    def _logout(self, *_):
        api.secrets.delete("refresh_token")
        self._tok = None
        self._exp = 0
        self._toast(self.s("logged_out"))

    # ----- настройки -----

    def create_settings(self):
        connected = bool(api.secrets.get("refresh_token"))
        return [
            Header(text=self.s("hdr")),
            Input(key="client_id", text=self.s("client_id"), default=""),
            Input(key="preset", text=self.s("preset"), default="banner"),
            Text(text=self.s("redirect"), subtext=REDIRECT_URI,
                 on_click=lambda *_: api.copy_text(REDIRECT_URI)),
            Button(text=self.s("login"),
                   subtext=self.s("on") if connected else self.s("off"),
                   on_click=self._login),
            Button(text=self.s("logout"), on_click=self._logout),
        ]
