DEFAULT = {
    'version': 2, 'theme': 'studio', 'preset': 'banner', 'width': 1500, 'height': 600,
    'title': 'Dead Limit', 'artist': 'Noisia, The Upbeats', 'subtitle': '', 'duration': 361, 'progress': 40,
    'backgroundColor': '#111111', 'nameColor': '#ffffff', 'authorColor': '#b3b3b3',
    'progressColor': '#ffffff', 'progressBarColor': '#777777', 'radius': 0,
    'blur': 40, 'brightness': .35, 'artBackground': True, 'thumbnail': '',
    'coverRadius': 30, 'coverBorder': 0, 'glow': 0, 'uppercase': False,
    'align': 'left', 'progressStyle': 'line', 'timeMode': 'sides', 'timeSize': 26,
    'layout': {
        'cover': {'x': 60, 'y': 60, 'size': 480, 'rotation': 0, 'flip': False},
        'title': {'x': 600, 'y': 195, 'size': 55},
        'artist': {'x': 600, 'y': 280, 'size': 45},
        'progress': {'x': 692, 'y': 384, 'width': 659, 'height': 10},
    },
}
PRESETS = {
    'banner': {},
    'center': {
        'width': 1600, 'height': 900, 'align': 'center', 'coverRadius': 0, 'coverBorder': 4,
        'blur': 65, 'brightness': .3, 'timeMode': 'center', 'timeSize': 28,
        'layout': {'cover': {'x': 650, 'y': 100, 'size': 300}, 'title': {'x': 800, 'y': 450, 'size': 56},
                   'artist': {'x': 800, 'y': 516, 'size': 40}, 'progress': {'x': 120, 'y': 690, 'width': 1360, 'height': 16}},
    },
    'glow': {
        'width': 2048, 'height': 976, 'align': 'center', 'coverRadius': 36, 'glow': 55,
        'blur': 75, 'brightness': .4, 'progressStyle': 'wave', 'timeSize': 32, 'uppercase': True,
        'layout': {'cover': {'x': 824, 'y': 128, 'size': 400}, 'title': {'x': 1024, 'y': 574, 'size': 80},
                   'artist': {'x': 1024, 'y': 720, 'size': 50}, 'progress': {'x': 700, 'y': 886, 'width': 640, 'height': 36}},
    },
    'minimal': {
        'width': 1280, 'height': 533, 'coverRadius': 26, 'blur': 50, 'brightness': .25,
        'timeMode': 'below', 'timeSize': 28,
        'layout': {'cover': {'x': 67, 'y': 67, 'size': 400}, 'title': {'x': 525, 'y': 88, 'size': 52},
                   'artist': {'x': 525, 'y': 160, 'size': 36}, 'progress': {'x': 525, 'y': 409, 'width': 688, 'height': 9}},
    },
}
THEMES = tuple(PRESETS)


def preset_config(name):
    if name not in PRESETS:
        raise ValueError('Неизвестный вариант карточки')
    result = deepcopy(DEFAULT)
    for key, value in PRESETS[name].items():
        if key != 'layout':
            result[key] = value
    for element, values in PRESETS[name].get('layout', {}).items():
        result['layout'][element].update(values)
    result['preset'] = name
    return result


def font(size, bold=False):
    paths = [Path('C:/Windows/Fonts') / ('arialbd.ttf' if bold else 'arial.ttf'),
             Path('/System/Library/Fonts/Supplemental') / ('Arial Bold.ttf' if bold else 'Arial.ttf'),
             Path('/usr/share/fonts/truetype/dejavu') / ('DejaVuSans-Bold.ttf' if bold else 'DejaVuSans.ttf'),
             Path('/usr/share/fonts/truetype/liberation') / ('LiberationSans-Bold.ttf' if bold else 'LiberationSans-Regular.ttf')]
    for path in paths:
        if path.exists():
            return ImageFont.truetype(str(path), max(1, round(size)))
    return ImageFont.load_default(size=max(1, round(size)))


def number(value, minimum, maximum):
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
        raise ValueError('Нужны конечные числовые значения')
    return max(minimum, min(maximum, value))


def merge_config(value):
    if not isinstance(value, dict):
        raise ValueError('Нужен объект настроек')
    if value.get('version') == 1:
        value = {key: value[key] for key in ('title', 'artist', 'duration', 'progress', 'thumbnail') if key in value}
    result = preset_config(value.get('preset', 'banner'))
    for key in DEFAULT:
        if key in value and key != 'layout':
            result[key] = value[key]
    layout = value.get('layout', {})
    if not isinstance(layout, dict):
        raise ValueError('Неверная компоновка')
    for name, defaults in DEFAULT['layout'].items():
        item = layout.get(name, {})
        if not isinstance(item, dict):
            raise ValueError('Неверные параметры элемента')
        result['layout'][name].update({key: item[key] for key in defaults if key in item})
    result['version'], result['theme'] = 2, 'studio'
    result['width'] = round(number(result['width'], 400, 2560))
    result['height'] = round(number(result['height'], 200, 1440))
    for key in ('title', 'artist', 'subtitle'):
        if not isinstance(result[key], str):
            raise ValueError('Название и исполнитель должны быть текстом')
    for key in ('backgroundColor', 'nameColor', 'authorColor', 'progressColor', 'progressBarColor'):
        if not isinstance(result[key], str):
            raise ValueError('Неверный цвет')
        ImageColor.getrgb(result[key])
    for key, minimum, maximum in (('duration', 1, 86400), ('progress', 0, 100), ('radius', 0, 200),
                                 ('blur', 0, 120), ('brightness', .05, 1), ('coverRadius', 0, 200),
                                 ('coverBorder', 0, 20), ('glow', 0, 120), ('timeSize', 12, 80)):
        result[key] = number(result[key], minimum, maximum)
    for key in ('artBackground', 'uppercase'):
        if type(result[key]) is not bool:
            raise ValueError('Неверное значение флага')
    for key, choices in (('align', ('left', 'center')), ('progressStyle', ('line', 'wave')), ('timeMode', ('sides', 'below', 'center', 'none'))):
        if result[key] not in choices:
            raise ValueError('Неверный режим оформления')
    for item in result['layout'].values():
        for key in item:
            if key == 'flip':
                if type(item[key]) is not bool:
                    raise ValueError('Неверное отражение')
            else:
                bounds = (8, 1200) if key == 'size' else (40, 2400) if key == 'width' else (2, 100) if key == 'height' else (-180, 180) if key == 'rotation' else (-2560, 5120)
                item[key] = number(item[key], *bounds)
    if not isinstance(result['thumbnail'], str) or len(result['thumbnail']) > 12_000_000:
        raise ValueError('Неверная обложка')
    return result


def clock(seconds):
    minutes, seconds = divmod(max(0, int(seconds)), 60)
    return f'{minutes:02d}:{seconds:02d}'


def fit_text(draw, text, face, max_width):
    text = ' '.join(text.split())
    if draw.textlength(text, font=face) <= max_width:
        return text
    low, high = 0, len(text)
    while low < high:
        middle = (low + high + 1) // 2
        if draw.textlength(text[:middle] + '…', font=face) <= max_width:
            low = middle
        else:
            high = middle - 1
    return text[:low] + '…' if low else ''


def wave_height(index):
    return .2 + .8 * abs(math.sin(index * 12.9898 + 78.233)) * math.sin(math.pi * (index + 1) / 65) ** .35


def render_card(value, cover):
    c = merge_config(value)
    size = (c['width'], c['height'])
    if c['artBackground']:
        image = cover.resize(size, Image.Resampling.LANCZOS).filter(ImageFilter.GaussianBlur(c['blur']))
        image = ImageEnhance.Brightness(image).enhance(c['brightness']).convert('RGBA')
    else:
        image = Image.new('RGBA', size, c['backgroundColor'])
    p = c['layout']['cover']
    s = round(p['size'])
    art = ImageOps.fit(cover, (s, s), method=Image.Resampling.LANCZOS).convert('RGBA')
    if p['flip']:
        art = ImageOps.mirror(art)
    mask = Image.new('L', (s, s))
    ImageDraw.Draw(mask).rounded_rectangle((0, 0, s-1, s-1), radius=c['coverRadius'], fill=255)
    art.putalpha(mask)
    if c['coverBorder']:
        ImageDraw.Draw(art).rounded_rectangle((0, 0, s-1, s-1), radius=c['coverRadius'], outline=c['nameColor'], width=round(c['coverBorder']))
    art = art.rotate(-p['rotation'], Image.Resampling.BICUBIC, expand=True)
    pos = (round(p['x'] + (s-art.width)/2), round(p['y'] + (s-art.height)/2))
    if c['glow']:
        halo = Image.new('RGBA', size)
        halo.alpha_composite(art, pos)
        image.alpha_composite(halo.filter(ImageFilter.GaussianBlur(c['glow'])))
    image.alpha_composite(art, pos)
    draw = ImageDraw.Draw(image)
    centered = c['align'] == 'center'
    for name, color in (('title', 'nameColor'), ('artist', 'authorColor')):
        p = c['layout'][name]
        face = font(p['size'], name == 'title' or c['preset'] == 'glow')
        max_width = max(0, 2*min(p['x'], size[0]-p['x'])-40 if centered else size[0]-p['x']-40)
        text = c[name].upper() if c['uppercase'] else c[name]
        draw.text((p['x'], p['y']), fit_text(draw, text, face, max_width), font=face, fill=c[color], anchor='mt' if centered else 'lt')
    p = c['layout']['progress']
    x, y, width, height = p['x'], p['y'], p['width'], p['height']
    if c['progressStyle'] == 'wave':
        for index in range(64):
            h = max(3, height * wave_height(index))
            bx, bw = x + index * width / 64, max(2, width / 64 * .55)
            color = c['progressColor'] if index/64 < c['progress']/100 else c['progressBarColor']
            draw.rounded_rectangle((bx, y+(height-h)/2, bx+bw, y+(height+h)/2), radius=bw/2, fill=color)
    else:
        draw.rounded_rectangle((x, y, x+width, y+height), radius=height/2, fill=c['progressBarColor'])
        filled = width * c['progress']/100
        if filled:
            draw.rounded_rectangle((x, y, x+filled, y+height), radius=min(height/2, filled/2), fill=c['progressColor'])
    elapsed, duration = clock(c['duration']*c['progress']/100), clock(c['duration'])
    face = font(c['timeSize'], c['timeMode'] in ('sides', 'center'))
    if c['timeMode'] == 'center':
        draw.text((x+width/2, y+height+20), f'({elapsed} | {duration})', font=face, fill=c['nameColor'], anchor='mt')
    elif c['timeMode'] in ('sides', 'below'):
        side = c['timeMode'] == 'sides'
        for tx, text, anchor in ((x-26 if side else x, elapsed, 'rm' if side else 'lt'), (x+width+26 if side else x+width, duration, 'lm' if side else 'rt')):
            draw.text((tx, y+height/2 if side else y+height+20), text, font=face, fill=c['nameColor'] if side else c['authorColor'], anchor=anchor)
    if c['subtitle']:
        draw.text((size[0]/2, size[1]-48), fit_text(draw, c['subtitle'], font(34), size[0]-80), font=font(34), fill=c['authorColor'], anchor='mt')
    if c['radius']:
        mask = Image.new('L', size)
        ImageDraw.Draw(mask).rounded_rectangle((0, 0, size[0]-1, size[1]-1), radius=c['radius'], fill=255)
        image.putalpha(mask)
    return image


# =====================================================================
# Вспомогательные функции плагина
# =====================================================================

def _u16(s):
    """Длина строки в UTF-16 code units (так считает Telegram)."""
    return len(s.encode("utf-16-le")) // 2


def _b64url(b):
    return base64.urlsafe_b64encode(b).rstrip(b"=").decode()


def _fmt_ms(ms):
    m, s = divmod(int(ms) // 1000, 60)
    return f"{m}:{s:02d}"


def _bar(progress, duration, width=12):
    if not duration:
        return ""
    filled = max(0, min(width, round(width * progress / duration)))
    return "▰" * filled + "▱" * (width - filled)


class _Text:
    """Накопитель текста с entities (смещения в UTF-16)."""

    def __init__(self):
        self.text = ""
        self.ents = []

    def add(self, s, **ent):
        start = _u16(self.text)
        self.text += s
        if ent:
            e = {"offset": start, "length": _u16(s)}
            e.update(ent)
            self.ents.append(e)
        return start

    def wrap(self, start, **ent):
        e = {"offset": start, "length": _u16(self.text) - start}
        e.update(ent)
        self.ents.append(e)

    def result(self):
        self.ents.sort(key=lambda e: (e["offset"], -e["length"]))
        return self.text, self.ents


def track_info(data):
    """Ответ currently-playing -> dict с полями трека или None."""
    item = (data or {}).get("item")
    if not item:
        return None
    if item.get("type") == "episode":
        show = item.get("show") or {}
        artist = show.get("name", "")
        extra = show.get("publisher", "")
        images = item.get("images") or show.get("images") or []
    else:
        artist = ", ".join(a.get("name", "") for a in item.get("artists", []))
        album = item.get("album") or {}
        extra = album.get("name", "")
        images = album.get("images") or []
    images = sorted(images, key=lambda i: i.get("width") or 0, reverse=True)
    return {
        "title": item.get("name", "?"),
        "artist": artist,
        "extra": extra,
        "playing": data.get("is_playing", False),
        "progress_ms": data.get("progress_ms") or 0,
        "duration_ms": item.get("duration_ms") or 0,
        "url": (item.get("external_urls") or {}).get("spotify"),
        "cover_url": images[0].get("url") if images else None,
    }


def build_caption(info):
    """⛧ <code>Трек — Артист</code> ⛧ -> (text, entities)."""
    name = info["title"]
    if info["artist"]:
        name += " — " + info["artist"]
    t = _Text()
    t.add("⛧ ")
    t.add(name, type="code")
    t.add(" ⛧")
    return t.result()


def build_text_card(info):
    """Запасной вариант без Pillow: текстовая карточка."""
    t = _Text()
    t.add("🎧 ")
    t.add("Сейчас играет" if info["playing"] else "На паузе", type="bold")
    t.add("\n")
    q = _u16(t.text)
    if info["url"]:
        t.add(info["title"], type="link", url=info["url"])
    else:
        t.add(info["title"], type="bold")
    if info["artist"]:
        t.add("\n" + info["artist"])
    if info["extra"]:
        t.add("\n")
        t.add(info["extra"], type="italic")
    if info["duration_ms"]:
        t.add(f"\n{'▶' if info['playing'] else '⏸'} {_bar(info['progress_ms'], info['duration_ms'])} "
              f"{_fmt_ms(info['progress_ms'])} / {_fmt_ms(info['duration_ms'])}")
    t.wrap(q, type="quote")
    return t.result()


def render_jpeg(info, preset, cover_bytes):
    """Рисует карточку и сохраняет во временный JPEG, возвращает путь."""
    cover = None
    if cover_bytes:
        try:
            with Image.open(io.BytesIO(cover_bytes)) as im:
                cover = ImageOps.exif_transpose(im).convert("RGB")
        except Exception:
            cover = None
    if cover is None:
        cover = Image.new("RGB", (640, 640), "#222222")

    duration = max(1.0, info["duration_ms"] / 1000)
    percent = max(0.0, min(100.0, info["progress_ms"] / 1000 / duration * 100))
    cfg = {
        "preset": preset if preset in PRESETS else "banner",
        "title": info["title"],
        "artist": info["artist"],
        "duration": duration,
        "progress": percent,
        "radius": 0,  # фото в Telegram без прозрачности, углы не скругляем
    }
    image = render_card(cfg, cover).convert("RGB")
    path = os.path.join(tempfile.gettempdir(),
                        f"spotify_now_{os.getpid()}_{int(time.time() * 1000)}.jpg")
    image.save(path, "JPEG", quality=92)
    return path


